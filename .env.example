DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/balport
SECRET_KEY=change-this-to-a-long-random-string

# ── Login (strongly recommended in production) ──────────────────────────────
# If APP_PASSWORD is empty, the app runs WITHOUT authentication.
APP_USERNAME=admin
APP_PASSWORD=

# ── LLM for PDF invoice parsing ─────────────────────────────────────────────
# Priority: 1) Anthropic Claude  →  2) Ollama (local or remote)
#
# Option A — Anthropic (cloud, best accuracy)
#   ANTHROPIC_API_KEY=sk-ant-api03-...
#   ANTHROPIC_MODEL=claude-haiku-4-5        # optional override
#
# Option B — Ollama (local)
#   OLLAMA_URL=http://localhost:11434
#   OLLAMA_MODEL=qwen3:4b
#
# Option C — Ollama (remote / cloud GPU)
#   OLLAMA_URL=https://your-ollama-server.com
#   OLLAMA_MODEL=llama3.2
#   OLLAMA_API_KEY=your-remote-key

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_API_KEY=
